{
  "manifest_version": 3,
  "name": "YT Downloader Premium",
  "version": "1.1.0",
  "description": "Baixe músicas e vídeos do YouTube direto da página, com histórico de tudo que já baixou.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Downloader Premium",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "premium@yt-downloader.local",
      "strict_min_version": "121.0"
    }
  }
}
