# Copie para .env e preencha. Nunca coloque o .env no git.

# ---------- obrigatório em produção ----------
YTD_ENV=production
YTD_PUBLIC_URL=https://seudominio.com.br
YTD_SECRET_KEY=troque-por-um-texto-aleatorio-longo
YTD_ADMIN_EMAILS=seu@email.com
YTD_CONTACT_EMAIL=contato@seudominio.com.br
YTD_OWNER_NAME=Victor Hugo
YTD_SITE_NAME=YT Downloader

# ---------- e-mail (link de login) ----------
# Gmail: smtp.gmail.com / 587 / seu Gmail / "senha de app" (myaccount.google.com/apppasswords)
YTD_SMTP_HOST=
YTD_SMTP_PORT=587
YTD_SMTP_USER=
YTD_SMTP_PASSWORD=
YTD_SMTP_FROM=
YTD_SMTP_SSL=0

# ---------- Mercado Pago ----------
# Credenciais em mercadopago.com.br/developers > Suas integrações > Credenciais de produção.
# Sem token, o pagamento roda em modo simulado (sem cobrança).
YTD_MP_ACCESS_TOKEN=
# Webhooks > Configurar notificações > URL: https://seudominio.com.br/api/pagamentos/webhook (evento: Pagamentos)
YTD_MP_WEBHOOK_SECRET=

# ---------- planos ----------
YTD_PREMIUM_PRICE_BRL=14.90
YTD_PREMIUM_DAYS=30
YTD_PREMIUM_DAILY_LIMIT=100
YTD_PREMIUM_MAX_DURATION_MIN=30
YTD_FREE_LIMIT_PER_HOUR=10
YTD_FREE_MAX_DURATION_MIN=15

# ---------- servidor ----------
YTD_MAX_WORKERS=2
YTD_FILE_TTL_MIN=30
YTD_AUTO_UPDATE=1
YTD_UPDATE_INTERVAL_H=12
YTD_LOG_LEVEL=INFO
# 1 quando houver proxy/plataforma na frente (Render, Railway, Nginx, Cloudflare)
YTD_BEHIND_PROXY=1
